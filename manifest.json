{
  "manifest_version": 3,
  "name": "Good Replies",
  "version": "1.0.0",
  "description": "A Chrome extension for good replies",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.goodreplies.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Good Replies"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}